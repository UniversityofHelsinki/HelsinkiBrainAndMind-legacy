{
    "name": "hbm/brain-and-mind",
    "description": "Helsinki University - Brain and Mind Drupal project",
    "type": "project",
    "homepage": "https://version.helsinki.fi/hbm/brain-and-mind",
    "license": "proprietary",
    "authors": [
        {
            "name": "Druid.fi",
            "email": "info@druid.fi"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "composer-runtime-api": "^2",
        "composer/installers": "^2.1",
        "cweagans/composer-patches": "^1.7",
        "druidfi/omen": "^0.7.0",
        "drupal/admin_toolbar": "^3.3",
        "drupal/color": "^1.0",
        "drupal/core-composer-scaffold": "^9.5",
        "drupal/core-recommended": "^9.5",
        "drupal/gin": "^3.0@RC",
        "drupal/gin_login": "^2.0",
        "drupal/gin_toolbar": "^1.0@RC",
        "drupal/menu_admin_per_menu": "^1.5",
        "drupal/metatag": "^1.22",
        "drupal/migrate_plus": "^5.1",
        "drupal/migrate_source_csv": "^3.4",
        "drupal/migrate_tools": "^5.0",
        "drupal/restui": "^1.21",
        "drupal/search_api": "^1.29",
        "drupal/search_api_autocomplete": "^1.7",
        "drupal/shs": "^2.0@RC",
        "drupal/simple_sitemap": "^3.8",
        "drupal/taxonomy_term_depth": "^2.5",
        "drupal/taxonomy_unique": "^2.5",
        "drupal/token": "^1.11",
        "drush/drush": "^11.5"
    },
    "require-dev": {
        "drupal/core-dev-pinned": "^9.5"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true
        }
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "drupal-scaffold": {
            "allowed-packages": [
                "drupal/core"
            ],
            "locations": {
                "web-root": "./public"
            },
            "file-mapping": {
                "[project-root]/.editorconfig": false
            }
        },
        "enable-patching": true,
        "installer-paths": {
            "public/core": ["type:drupal-core"],
            "public/libraries/{$name}": ["type:drupal-library"],
            "public/modules/contrib/{$name}": ["type:drupal-module"],
            "public/modules/custom/{$name}": ["type:drupal-custom-module"],
            "public/profiles/{$name}": ["type:drupal-profile"],
            "public/themes/contrib/{$name}": ["type:drupal-theme"],
            "public/themes/custom/{$name}": ["type:drupal-custom-theme"],
            "drush/{$name}": ["type:drupal-drush"]
        },
        "patches": {
            "drupal/shs": {
                "Custom implode default values": "patches/implode_default_value.patch"
            },
            "drupal/taxonomy_term_depth": {
                "https://www.drupal.org/i/3283096": "https://git.drupalcode.org/project/taxonomy_term_depth/-/merge_requests/4.diff"
            }
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ]
}
